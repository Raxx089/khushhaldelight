# Browser-safe values only. Never put service-role, Razorpay secret, Shiprocket,
# OpenAI, Meta, Resend, or Twilio credentials in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_WHATSAPP_NUMBER=918796729435

# Configure the remaining values as Supabase Edge Function secrets, not here.
# Required:
# ALLOWED_ORIGINS=https://your-store-domain.in,http://localhost:5173
# ORDER_ACCESS_SECRET=<random secret, at least 32 bytes>
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# SHIPROCKET_EMAIL=...
# SHIPROCKET_PASSWORD=...
# SHIPROCKET_PICKUP_PIN=...
# SHIPROCKET_PICKUP_LOCATION=...
# SHIPROCKET_WEBHOOK_TOKEN=<random webhook token>
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-4o-mini
# WHATSAPP_APP_SECRET=...
# WHATSAPP_ACCESS_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_VERIFY_TOKEN=<random webhook verification token>
# PUBLIC_SITE_URL=https://your-store-domain.in
#
# Optional, approved Meta WhatsApp templates only:
# WHATSAPP_API_VERSION=v22.0
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_TEMPLATE_ORDER_CONFIRMED=...
# WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED=...
# WHATSAPP_TEMPLATE_IN_TRANSIT=...
# WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=...
# WHATSAPP_TEMPLATE_DELIVERED=...
#
# Optional transactional notifications:
# RESEND_API_KEY=...
# RESEND_FROM_EMAIL=Khushhal Delight <orders@your-domain.in>
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=...
